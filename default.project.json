{
  "name": "Toilet RNG",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": { "StreamingEnabled": true, "StreamingMinRadius": 128, "StreamingTargetRadius": 512, "StreamingIntegrityMode": "PauseOutsideLoadedArea", "StreamOutBehavior": "Opportunistic" }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": { "ChatVersion": "TextChatService", "CreateDefaultTextChannels": true },
      "ChatWindowConfiguration": { "$className": "ChatWindowConfiguration", "$properties": { "Enabled": true } }
    },
    "Players": {
      "$className": "Players",
      "$properties": { "MaxPlayersInternal": 12, "PreferredPlayersInternal": 12 }
    },
    "Lighting": {
      "$className": "Lighting",
      "$properties": { "LightingStyle": "Soft", "PrioritizeLightingQuality": true }
    },
    "TextChatService": {
      "$className": "TextChatService",
      "$properties": { "ChatVersion": "TextChatService", "CreateDefaultTextChannels": true },
      "ChatWindowConfiguration": {
        "$className": "ChatWindowConfiguration",
        "$properties": { "Enabled": true }
      }
    },
    "ReplicatedStorage": {
      "Shared": { "$path": "src/shared" },
      "ModelTemplates": { "$path": "assets/rbxm/ModelTemplates.rbxm" },
      "EnvTemplates": { "$path": "assets/rbxm/EnvTemplates.rbxm" },
      "Wave1Templates": { "$path": "assets/rbxm/Wave1Templates.rbxm" }
    },
    "ServerStorage": { "AdminClient": { "$path": "src/admin-client" } },
    "ServerScriptService": { "Server": { "$path": "src/server" } },
    "StarterPlayer": { "StarterPlayerScripts": { "Client": { "$path": "src/client" } } }
  }
}
