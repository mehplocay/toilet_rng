local Tutorial = require("../src/client/UI/Tutorial")
local Limiter = require("../src/server/Services/RateLimiter")
local Remotes = require("../src/shared/Config/Remotes")

assert(Tutorial.NextStep(1, "Flush", { ItemId = "Poop" }) == 3)
assert(Tutorial.NextStep(2, "Flush", { ItemId = "Rat" }) == 3)
assert(Tutorial.NextStep(2, "Flush", { Success = false }) == 2)
assert(Tutorial.NextStep(3, "Sell", { Success = false }) == 3)
assert(Tutorial.NextStep(3, "Sell", { Success = true }) == 4)
assert(Tutorial.NextStep(4, "BuyToilet", { Success = false }) == 4)
assert(Tutorial.NextStep(4, "BuyToilet", { Success = true }) == 5)
assert(Tutorial.NextStep(3, "BuyToilet", { Success = true }) == 3)
assert(Tutorial.NextStep(4, "Sell", { Success = true }) == 4)
assert(Tutorial.NextStep(5, "Flush", { ItemId = "Poop" }) == 5)
assert(Tutorial.NextStep(3, "Sell", nil) == 3)
assert(Tutorial.NextStep(3, "Sell", { Success = "true" }) == 3)

local limiter, player = Limiter.new(Remotes.Limits), {}
assert(limiter:Allow(player, "TutorialDone"))
assert(limiter:Allow(player, "TutorialDone"))
assert(not limiter:Allow(player, "TutorialDone"))
limiter:Remove(player)
assert(limiter.Players[player] == nil)
print("Tutorial checks passed: server outcomes, failure handling, step order, completion rate limit")
